# Copy to .env and fill in real values. Never commit .env.
# Values must not contain "$": Docker Compose reads it as a variable.
# Restart the server after changing anything here.

DJANGO_SECRET_KEY=change-me

# Signs the mobile app's JWTs. Optional: falls back to DJANGO_SECRET_KEY when empty.
# Changing it logs every mobile user out.
JWT_SIGNING_KEY=

# Debug mode. True: Django's detailed error pages (development only).
# False: Pivot's own error pages, like production. Anything other than "true" counts as False.
# With False, run `python manage.py runserver --insecure` locally so CSS and images still load.
DJANGO_DEBUG=True

# Comma-separated hosts Django answers to. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pivot
POSTGRES_USER=pivot
POSTGRES_PASSWORD=change-me
# Host port for the Docker database. Use another port (e.g. 5434) if Postgres is also installed locally.
POSTGRES_PORT=5432
DATABASE_URL=postgres://pivot:change-me@db:5432/pivot

TS_USER=pivot
TS_PASSWORD=change-me
TIMESERIES_URL=postgres://pivot:change-me@timeseries:5432/telemetry

MINIO_USER=pivot
MINIO_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000

# Email. True: really sent through Resend (needs RESEND_API_KEY from resend.com/api-keys).
# False: only logged to the terminal running the server. Anything other than "true" counts as False.
SEND_EMAILS=False
RESEND_API_KEY=
# Sender address. With resend it must be on a domain verified in Resend.
DEFAULT_FROM_EMAIL=Pivot <no-reply@example.com>
# Optional: public https address of the static files, for the logos in emails.
# Empty: the logos are attached to each email. Example: https://yourdomain.com/static/
EMAIL_STATIC_URL=

# Digits per one-time email code; the emails and the code page follow it. Default 8.
EMAIL_CODE_LENGTH=8
