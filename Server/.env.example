# Copy to .env and fill in real values. Never commit .env.
# Values must not contain "$": Docker Compose reads it as a variable.
# Restart the server after changing anything here.

DJANGO_SECRET_KEY=change-me

# Signs the mobile app's JWTs. Optional: falls back to DJANGO_SECRET_KEY when empty.
# Changing it logs every mobile user out.
JWT_SIGNING_KEY=

# Debug mode. True: Django's detailed error pages (development only).
# False: Pivot's own error pages, like production. Anything other than "true" counts as False.
# With False, run `python manage.py runserver --insecure` locally so CSS and images still load.
DJANGO_DEBUG=True

# Comma-separated hosts Django answers to. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pivot
POSTGRES_USER=pivot
POSTGRES_PASSWORD=change-me
# Host port for the Docker database. Use another port (e.g. 5434) if Postgres is also installed locally.
POSTGRES_PORT=5432
DATABASE_URL=postgres://pivot:change-me@db:5432/pivot

TS_USER=pivot
TS_PASSWORD=change-me
TIMESERIES_URL=postgres://pivot:change-me@timeseries:5432/telemetry

MINIO_USER=pivot
MINIO_PASSWORD=change-me-too

# Object store address. http://minio:9000 from inside Docker; http://localhost:9090 when Django runs outside Docker.
S3_ENDPOINT=http://minio:9000
# Bucket for all stored files. Must exist (create it once, e.g. with `mc mb`).
S3_BUCKET=pivot-files
# Optional: dedicated app user for the bucket. Empty: falls back to MINIO_USER / MINIO_PASSWORD.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Voice analysis tool: the .py file with ProcessSingleFile. Relative to Server/, or an absolute path.
# In Docker, point it at wherever the tool is mounted or copied in the container.
VOICE_ANALYSIS_SCRIPT=../VoiceMock/FeatureExtractor.py
# Python that runs the tool. Empty: the server's own Python.
VOICE_ANALYSIS_PYTHON=

# Email. True: really sent through Resend (needs RESEND_API_KEY from resend.com/api-keys).
# False: the text version is printed in the terminal running the server. Anything other than "true" counts as False.
SEND_EMAILS=False
RESEND_API_KEY=
# Sender address. With resend it must be on a domain verified in Resend.
DEFAULT_FROM_EMAIL=Pivot <no-reply@example.com>
# Optional: public https address of the static files, for the logos in emails.
# Empty: the logos are attached to each email. Example: https://yourdomain.com/static/
EMAIL_STATIC_URL=

# Digits per one-time email code; the emails and the code page follow it. Default 8.
EMAIL_CODE_LENGTH=8

# python manage.py seed (development only, needs DJANGO_DEBUG=True): a trainer,
# a speaker under them and an open invite to an email with no account yet.
# The trainer and the speaker log in with SEED_PASSWORD.
SEED_ADMIN_EMAIL=trainer@example.com
SEED_SPEAKER_EMAIL=speaker@example.com
SEED_INVITE_EMAIL=invited@example.com
SEED_PASSWORD=Change-me-123!
# Optional: a second trainer who invites the speaker above, to try switching trainers.
SEED_SECOND_ADMIN_EMAIL=

# Working files the web and live processes share (talk recordings while a talk runs).
# Docker: the host folder mounted as Server/files in both containers. Create it
# before the first `docker compose up` and make it writable for the containers'
# user (uid 1000), or Docker creates it owned by root and they can't write.
FILES_HOST_DIR=./files
# Outside Docker only: another folder than Server/files. Leave empty in Docker.
FILES_DIR=

# WebRTC. STUN/TURN servers the browser and the live process use, comma-separated.
# Local development: empty (the browser reaches run_live on localhost directly).
# VPS: the coturn service, by the VPS's public IP, e.g. turn:203.0.113.7:3478
RTC_ICE_SERVERS=
# True on the VPS: only connections relayed through coturn (the live container
# isn't reachable from outside). Needs a turn: URL above and TURN_SECRET.
RTC_RELAY_ONLY=False

# The live process's internal API (only Django calls it). The token is required:
# run_live doesn't start without it. Long and random, like TURN_SECRET.
LIVE_INTERNAL_TOKEN=change-me
# Where run_live listens and Django reaches it. Defaults: 127.0.0.1, 8100,
# and the URL made from them. Leave empty unless they run on different machines.
LIVE_INTERNAL_HOST=
LIVE_INTERNAL_PORT=
LIVE_INTERNAL_URL=

# coturn (docker compose --profile turn, on the VPS only).
# The VPS's public IP, and the domain (realm) the certificate is for.
TURN_EXTERNAL_IP=
TURN_REALM=pivot.example.com
# Shared with Django, which makes each browser's short-lived TURN credentials from it.
# Long and random (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
TURN_SECRET=change-me
# The Let's Encrypt folder (the whole of it); the certificate is live/<TURN_REALM>/ inside.
TURN_CERT_DIR=/etc/letsencrypt
